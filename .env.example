# Environment Configuration
# Set this to 'development', 'staging', or 'production'
NODE_ENV=development

# OpenAI is not a frontend variable. A VITE_ key is copied into the public
# JavaScript bundle and GitHub will revoke it on a public repository.
# Store the key as a Firebase secret instead:
#   firebase functions:secrets:set OPENAI_API_KEY
#   firebase deploy --only functions:handleAIChat --project resilient-mind-cca45

# Firebase Configuration
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# API Configuration
# Development: http://localhost:4000/api
# Staging: https://staging-api.resilientmind.app/api
# Production: https://api.resilientmind.app/api
VITE_API_URL=http://localhost:4000/api

# Feature Flags
VITE_ENABLE_DEVTOOLS=true
VITE_ENABLE_LOGGING=true

# Note: Copy this file to .env and replace the placeholder values with actual values
# For security, never commit the actual .env file to version control 